{
  "name": "be-like-water",
  "version": "0.1.0",
  "description": "Be Like Water: spine recovery that adapts to you. Marketing site, client app and clinician review queue.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
