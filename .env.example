# Public URL of the site, used in sign-in links and emails.
APP_URL=http://localhost:8787
# Signs sessions. Required in production; use a long random value.
SESSION_SECRET=
# Coach/admin accounts (comma-separated emails). These see every journey.
ADMIN_EMAILS=
# Private beta: only these emails (plus coaches) can sign up. Empty = open to anyone.
ALLOWED_EMAILS=
# Claude API key for program generation (console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional: model override. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=
# Local testing only: AI_MODE=stub returns placeholder programs without calling Claude.
# AI_MODE=stub
# Exercise demo videos: a YouTube Data API v3 key (Google Cloud). Without it, exercises link to a YouTube search.
YOUTUBE_API_KEY=
# Oura ring (developer.ouraring.com / cloud.ouraring.com → API applications). Redirect URI: <APP_URL>/auth/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Email (resend.com). Without a key, emails and sign-in links print to the server log.
RESEND_API_KEY=
EMAIL_FROM=Be Like Water <hello@example.com>
# Where the SQLite database and uploads live.
DATA_DIR=./data
PORT=8787
